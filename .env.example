# ──────────────────────────────────────────────────────────────────────
# PolyRoute environment variables
#
# Copy to `.env` (gitignored) and fill in real values. Every setting in
# src/polyroute/core/config.py can be overridden here using the
# POLYROUTE_ prefix. Provider API keys are NOT prefixed — they use the
# vanilla env var name that each provider's SDK expects.
# ──────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────
POLYROUTE_HOST=0.0.0.0
POLYROUTE_PORT=8000
POLYROUTE_LOG_LEVEL=INFO
POLYROUTE_ENVIRONMENT=development
POLYROUTE_CONFIG_DIR=./config

# ── Datastores ───────────────────────────────────────────────────────
POLYROUTE_DATABASE_URL=postgresql+asyncpg://polyroute:polyroute@localhost:5432/polyroute
POLYROUTE_REDIS_URL=redis://localhost:6379/0

# ── Auth ─────────────────────────────────────────────────────────────
# Long random string — required to access /admin/* endpoints.
POLYROUTE_ADMIN_TOKEN=replace-me-with-a-long-random-string

# ── Routing / cost ───────────────────────────────────────────────────
# Model used as the baseline for savings calculations (the "what if we
# sent everything to the flagship" counterfactual). Must exist in
# routing_policy.yaml.
POLYROUTE_BASELINE_FLAGSHIP_MODEL=claude-opus-4-7

# Global per-request deadline in seconds.
POLYROUTE_REQUEST_DEADLINE_SECONDS=60

# ── Rate limiting (token bucket, per client) ─────────────────────────
POLYROUTE_DEFAULT_RATE_LIMIT_RPM=120
POLYROUTE_DEFAULT_RATE_LIMIT_BURST=30

# ── Caching ──────────────────────────────────────────────────────────
POLYROUTE_EXACT_CACHE_TTL_SECONDS=3600
POLYROUTE_SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
# Above this temperature, cache returns are skipped (determinism matters).
POLYROUTE_CACHE_TEMPERATURE_THRESHOLD=0.3

# ── LLM classifier (stage 2) ─────────────────────────────────────────
POLYROUTE_LLM_CLASSIFIER_ENABLED=true
POLYROUTE_LLM_CLASSIFIER_CONFIDENCE_THRESHOLD=0.6
# Maximum fraction of traffic that may escalate to the LLM classifier
# per rolling minute. 0.15 = 15%.
POLYROUTE_LLM_CLASSIFIER_TRAFFIC_CAP=0.15

# ── Circuit breaker ──────────────────────────────────────────────────
POLYROUTE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
POLYROUTE_CIRCUIT_BREAKER_WINDOW_SECONDS=60
POLYROUTE_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# ── Observability ────────────────────────────────────────────────────
# OTLP endpoint for OpenTelemetry traces (optional — leave unset to disable).
# POLYROUTE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── Provider API keys (no POLYROUTE_ prefix — match SDK expectations) ─
# At least one provider must have a working key. Semantic cache
# requires OPENAI_API_KEY regardless of routing config.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
